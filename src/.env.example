# ─────────────────────────────────────────────────────────────────
# Port Operations Optimizer — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit the .env file — it is in .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:Ankit%4010@localhost:5432/ibm_bob

# ── Application ──────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# ── CORS ─────────────────────────────────────────────────────────
# JSON array of allowed origins for CORS
CORS_ORIGINS=["http://localhost:3000"]

# ── Logging ──────────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── JWT / Authentication ─────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── IBM watsonx.ai (future use) ─────────────────────────────────
# WATSONX_API_KEY=your_api_key_here
# WATSONX_PROJECT_ID=your_project_id_here
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

